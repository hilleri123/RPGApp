# Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Здесь перечислены все переменные, которые читает код. Значения ниже —
# рабочие для локальной разработки; всё, что помечено change-me, в проде
# обязательно заменить.

# --- Frontend (web-client) ---
# Dev (через прокси Next): /api
# Prod: полный URL API
NEXT_PUBLIC_API_URL=https://rpgzona.xyz/api

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rpg_sessions

# --- Backend / auth ---
# Ключ подписи JWT. В production приложение не поднимется с дефолтным или
# пустым значением — подписанный им токен подделает кто угодно.
SECRET_KEY=change-me-long-random-string
ALGORITHM=HS256

# development | production. Влияет на строгость проверки SECRET_KEY
# и на дефолт COOKIE_SECURE.
ENV=development

# Флаг secure на куках с токенами. Пусто — берётся из ENV (в проде true).
# По http браузер secure-куку не сохранит, поэтому локально должно быть false.
COOKIE_SECURE=

# Origin-ы для CORS через запятую. Звёздочка недопустима: аутентификация
# на куках, и с allow_credentials браузер отбросит такой ответ.
CORS_ORIGINS=http://localhost:3000,http://localhost:6602,http://127.0.0.1:3000

# --- Пути и префиксы ---
# Куда складываются загруженные файлы и по какому префиксу они раздаются.
# Неверный MEDIA_ROOT означает, что загрузки уйдут не туда, где их ждёт раздача.
MEDIA_ROOT=/app/media
MEDIA_URL_PREFIX=/media

# Базовый URL API — из него собираются публичные ссылки на медиа.
BASE_URL=http://localhost:6602/api

# Префикс, за которым смонтирован API. Dev: /api, prod: пусто.
ROOT_PATH=/api

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Telegram ---
# Токен @BotFather; нужен app (WebApp HMAC) и telegram-bot
BOT_TOKEN=

# Публичный URL сайта для magic-link из бота (/link, лобби).
# Не путать с NEXT_PUBLIC_API_URL — это фронт без /api.
# Dev: http://localhost:6602
# Prod: https://rpgzona.xyz
WEB_CLIENT_URL=https://rpgzona.xyz

# --- RabbitMQ (бот ↔ API, дальше — нейронки) ---
# Значения ниже — для локальной разработки. В compose.prod.yml дефолтов нет:
# без этих переменных прод не поднимется, чтобы не уехать с паролем rpg:rpg.
RABBIT_URL=amqp://rpg:rpg@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=rpg
RABBITMQ_DEFAULT_PASS=rpg
# Таймаут RPC-вызова бота, секунды.
BOT_RPC_TIMEOUT=10

# --- Стол в Переговорке ---
# Общий ключ API и контейнера table-bridge. В проде замените.
TABLE_BRIDGE_TOKEN=dev-table-bridge
# SpeechKit и черновик (YandexGPT / YandexART). Пусто — реплики не выдумываются,
# черновик собирается из реплик и хроники, картинки остаются запросами.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# HTTP-прокси на российском сервере. Через него table-bridge открывает
# Переговорку: сервис пускает только российские IP. Пусто — прямое соединение.
# PEREGOVORKA_PROXY_URL=http://user:password@176.123.165.212:8888
PEREGOVORKA_PROXY_URL=
